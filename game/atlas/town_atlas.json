    "colorSpace": "linear",
    "convention": "OpenGL +Y"
   },
   "orm": {
    "file": "town_orm",
    "colorSpace": "linear",
    "channels": "R=AO G=roughness B=metalness"
   }
  },
  "formats": [
   "ktx2",
   "jpg"
  ],
  "ktx2Note": "KTX2 files are stored bottom-row-first (toktx --lower_left_maybe_flip_y), so no flip is needed at upload; JPG/PNG are top-row-first and need flipY."
 },
